# Public application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_APP_URL=http://localhost:3000

# AI providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_RECAP_MODEL=
GEMINI_TOPIC_MODEL=
GOOGLE_TTS_API_KEY=

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=

# Optional product flags
# These checks use an exact string convention: 1 enables; 0 or unset disables.
# Do not use true/false here.
NEXT_PUBLIC_ENABLE_REALTIME=0
NEXT_PUBLIC_AI_TOPIC_SUGGESTIONS_ENABLED=0
NEXT_PUBLIC_AUTHOR_SUBSCRIPTIONS_ENABLED=0
NEXT_PUBLIC_AUTHOR_SUBSCRIPTIONS_UX_V2_ENABLED=0
NEXT_PUBLIC_TOPIC_SUBSCRIPTIONS_ENABLED=0
DEBATE_V2_ACTIVATION_ENABLED=0

# Safe default: keep scheduled daily-brief delivery in dry-run mode until the
# target environment, recipient query, push credentials, and cron are verified.
DAILY_BRIEF_DRY_RUN=1

# Admin and scheduled jobs
ADMIN_EMAIL=
ADMIN_SECRET=
CRON_SECRET=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
