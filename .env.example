# Public application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional dedicated HMAC secret for signed feed-placement attribution.
# When omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY.
FEED_EXPOSURE_SIGNING_SECRET=
# Optional dedicated HMAC secret for page-view/read tokens. Falls back to the
# feed secret, then SUPABASE_SERVICE_ROLE_KEY.
POST_ENGAGEMENT_SIGNING_SECRET=

# Email
# Sender identities live in lib/emailSenders.ts, not in an env var. These two
# only move the domain those identities send from.
RESEND_API_KEY=
# Domain for the human and institutional mailboxes. Defaults to NEXT_PUBLIC_APP_DOMAIN.
EMAIL_SENDER_DOMAIN=
# Domain for automated platform mail. Defaults to EMAIL_SENDER_DOMAIN. Set this
# to a subdomain to keep notification volume off the human addresses.
EMAIL_PLATFORM_SENDER_DOMAIN=
EMAIL_APP_URL=http://localhost:3000
# Signing secret for the Resend webhook at /api/webhooks/resend. Resend shows it
# once, as whsec_..., when the endpoint is created in its dashboard. Without it
# the route answers 503 and no broadcast ever records a delivery. Subscribe:
# email.delivered, email.bounced, email.complained, email.failed,
# email.suppressed, contact.updated
RESEND_WEBHOOK_SECRET=

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=

# Optional product flags
# These checks use an exact string convention: 1 enables; 0 or unset disables.
# Do not use true/false here.
NEXT_PUBLIC_ENABLE_REALTIME=0
# Enables optional internal-link resolution for Article references after its database column is applied.
NEXT_PUBLIC_REFERENCE_RESOLUTION_ENABLED=0


# Admin and scheduled jobs
ADMIN_EMAIL=
ADMIN_SECRET=
CRON_SECRET=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
