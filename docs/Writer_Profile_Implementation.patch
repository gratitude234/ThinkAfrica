+.profile-section-title { margin: 0 0 12px; font-family: var(--font-newsreader), Georgia, serif; font-size: 19px; font-weight: 600; line-height: 1.3; }
+.profile-section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
+.profile-view-all { font-size: 13px; font-weight: 600; color: #0B4A36; padding-block: 8px; }
+.profile-publication { position: relative; display: flex; align-items: flex-start; gap: 16px; padding: 20px 0; border-bottom: 1px solid #EDE8DD; }
+.profile-publications-preview .profile-publication { padding: 14px 0; }
+.profile-article-title { font-family: var(--font-newsreader), Georgia, serif; font-size: 21px; line-height: 1.3; font-weight: 600; overflow-wrap: anywhere; }
+.profile-publications-preview .profile-article-title { font-size: 20px; }
+.profile-standfirst { margin-top: 4px; font-size: 15px; line-height: 1.5; color: #3F4A44; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
+.profile-post-text { font-size: 16px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
+.profile-publication-meta { margin-top: 6px; font-size: 12px; color: #6B6B6B; }
+.profile-publication:hover a { color: #0B4A36; }
+.profile-publication-cover { width: 112px; height: 84px; border-radius: 6px; flex-shrink: 0; overflow: hidden; }
+.profile-publications-preview .profile-publication-cover { width: 88px; height: 66px; }
+.is-post .profile-publication-cover { width: 64px; height: 64px; }
+.profile-publications-preview .is-post .profile-publication-cover { width: 56px; height: 56px; }
+.profile-topics { display: flex; flex-wrap: wrap; gap: 8px; }
+.profile-topics li > * { display: inline-flex; align-items: center; min-height: 30px; border: 1px solid #D8D2C4; border-radius: 16px; padding: 4px 13px; font-size: 12.5px; font-weight: 500; color: #3F4A44; overflow-wrap: anywhere; }
+.profile-topics a:hover { color: #0B4A36; border-color: #0B4A36; }
