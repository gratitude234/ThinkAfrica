+.profile-compact { position: fixed; top: var(--app-nav-offset, 64px); left: var(--app-rail-width, 0px); right: 0; z-index: 40; border-bottom: 1px solid #E4DFD4; background: #FAF8F5; font-family: var(--font-public-sans), system-ui, sans-serif; }
+.profile-compact-inner { max-width: 780px; margin: 0 auto; display: grid; grid-template-columns: minmax(0,1fr) auto auto; align-items: center; gap: 18px; padding: 0 20px; min-height: 56px; }
+.profile-compact-name { font-family: var(--font-newsreader), Georgia, serif; font-size: 17px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.profile-tabs-compact { border: 0; gap: 16px; }
+.profile-tabs-compact .profile-tab { font-size: 13px; }
+.profile-edit-compact { display: inline-flex; align-items: center; min-height: 36px; padding: 6px 14px; border-radius: 8px; background: #0B4A36; color: #FAF8F5; font-size: 12px; font-weight: 600; white-space: nowrap; }
+.profile-about { display: grid; grid-template-columns: 150px minmax(0,1fr); gap: 48px; }
+.profile-about-index { position: sticky; top: calc(var(--app-nav-offset, 64px) + 80px); align-self: start; display: flex; flex-direction: column; gap: 4px; }
+.profile-about-index a { padding: 9px 0; font-size: 13px; color: #6B7570; }
+.profile-about-index [aria-current] { color: #0B4A36; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
+.profile-about-content { min-width: 0; font-size: 15px; line-height: 1.7; color: #3F4A44; }
+.profile-about-section { padding-bottom: 26px; margin-bottom: 26px; border-bottom: 1px solid #E9E5DE; scroll-margin-top: 176px; overflow-wrap: anywhere; }
+.profile-about-section h3 { font-size: 15px; font-weight: 600; color: #1B2420; }
+.profile-about-date { margin-top: 4px; font-size: 13px; color: #6B7570; }
+.profile-external-link { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; min-height: 44px; color: #0B4A36; }
+.profile-external-label { font-size: 10px; letter-spacing: .06em; color: #6B7570; }
+.profile-about-edit { display: inline-flex; min-height: 44px; align-items: center; font-size: 13px; font-weight: 600; color: #0B4A36; }
+@media (max-width: 767px) {
+  .profile-identity-top > :first-child { flex-basis: 100%; }
+  .profile-compact-inner { grid-template-columns: minmax(0,1fr) auto; gap: 0 12px; padding-top: 8px; }
+  .profile-compact-name { grid-row: 1; }
+  .profile-compact-action { grid-column: 2; grid-row: 1; }
+  .profile-compact-tabs { grid-column: 1 / -1; grid-row: 2; min-width: 0; }
+  .profile-tabs-compact { gap: 24px; }
+  .profile-compact-action button { min-height: 36px; }
+  .profile-about { display: block; }
+  .profile-about-index { display: none; }
+  .profile-topics a { min-height: 36px; }
