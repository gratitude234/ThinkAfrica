+.profile-facts dt { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #6B6B6B; }
+.profile-facts dd { font-size: 14px; overflow-wrap: anywhere; }
+.profile-empty { padding: 24px 0; font-size: 14px; line-height: 1.6; color: #6B6B6B; }
+.profile-empty a { display: inline-flex; align-items: center; min-height: 44px; color: #0B4A36; font-weight: 600; }
