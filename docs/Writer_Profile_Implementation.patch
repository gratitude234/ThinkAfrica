+.profile-tab { display: inline-flex; align-items: center; flex-shrink: 0; min-height: 44px; border-bottom: 2px solid transparent; color: #6B6B6B; font-size: 14px; font-weight: 600; white-space: nowrap; }
+.profile-tab[aria-selected="true"] { color: #0B4A36; border-bottom-color: #0B4A36; }
